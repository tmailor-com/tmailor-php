{
    "name": "tmailor/tmailor",
    "description": "PHP SDK for the Tmailor Open API: create receive-only temporary email addresses and read their messages from your backend (sign-up tests, OTP checks, inbox automation).",
    "type": "library",
    "license": "MIT",
    "keywords": ["tmailor", "temporary email", "temp mail", "disposable email", "otp", "email testing", "e2e", "api", "sdk"],
    "homepage": "https://tmailor.com",
    "authors": [
        {
            "name": "Tmailor",
            "homepage": "https://tmailor.com"
        }
    ],
    "support": {
        "issues": "https://github.com/tmailor-com/tmailor-php/issues",
        "source": "https://github.com/tmailor-com/tmailor-php",
        "docs": "https://platform.tmailor.com/docs"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Tmailor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tmailor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:live": "phpunit --testsuite live",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
